# Base de datos PostgreSQL (accesible solo desde la red interna vetsoft_internal)
POSTGRES_DB=vetsoft_db
POSTGRES_USER=vetsoft_app
POSTGRES_PASSWORD=REEMPLAZAR_CLAVE_SEGURA_POSTGRES

# Seguridad Spring Boot / JWT (obligatorio en perfil prod)
JWT_SECRET=REEMPLAZAR_SECRETO_HS256_MINIMO_64_CARACTERES

# Puertos expuestos al host
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Integración Frontend y Gemini IA
VITE_API_URL=http://localhost:8080
GEMINI_API_KEY=REEMPLAZAR_API_KEY_GEMINI
